# Copy this file to .env.local for local development. .env.local is gitignored.
# On Vercel, set the same variables under Project Settings > Environment Variables.

# Required. Read on the server only; never give it a NEXT_PUBLIC_ prefix, which
# would ship it to the browser.
ANTHROPIC_API_KEY=

# Optional. The Claude model every call uses. Defaults to claude-opus-5.
# CLAUDE_MODEL=claude-opus-5

# Optional. A private Vercel Blob store's token. With it, each exchange (the
# response, the judgment and the feedback) is saved anonymously, one JSON file
# per exchange; without it, nothing is stored. Connecting a Blob store to the
# Vercel project sets it there.
# BLOB_READ_WRITE_TOKEN=
